# Frontend build-time API origin. Public value; no credentials belong here.
VITE_API_BASE_URL=https://your-render-service.onrender.com/api
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Backend runtime environment
PORT=10000
NODE_ENV=production
PYTHON_BIN=/opt/venv/bin/python
WORKSPACE_ROOT=/app
CORS_ORIGINS=https://your-frontend.vercel.app
FIREBASE_PROJECT_ID=your-firebase-project-id
# Provide this only to the API runtime (for example Render); never put it in a VITE_* variable.
FIREBASE_SERVICE_ACCOUNT_JSON=
FFCS_STORE_PATH=/var/data/ffcs_store.json
FFCS_LEGACY_STORE_PATH=
FFCS_PYTHON_TIMEOUT_MS=30000
LOG_LEVEL=info
